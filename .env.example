# ==============================================================================
# Google Drive Backend Storage Configuration
# ==============================================================================
# All Carbon Ledger files are saved to the administrator's Google Drive.
# End users NEVER see Google OAuth screens.

# Existing "Carbon Ledger" Google Drive Root Folder ID
GOOGLE_DRIVE_ROOT_FOLDER_ID=1SBQEAA1BhMo-VdEkKmYP4K4PESV5HugW

# --- Option A: Personal Google Account (@gmail.com) ---
# Use an Admin OAuth 2.0 Web Client + Server Refresh Token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Option B: Google Cloud Service Account ---
# If using a Google Cloud Service Account (folder must be shared with service account email as Editor)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# ==============================================================================
# Carbon Ledger Authentication & App Configuration
# ==============================================================================
# Secret key (at least 16 characters) used to sign HTTP-only session cookies
SESSION_SECRET=

# Optional email settings for password reset
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000
